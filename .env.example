# Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SECRET_KEY=your_secret_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The site's public origin (no path). The sign-up confirmation email links to <this>/sign-in,
# which must be in Supabase → Authentication → URL Configuration → Redirect URLs.
# Unset: the page's own origin. Password-reset emails link to <this>/auth/confirm (also a Redirect URL).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# The site's own email sender (confirm-first sign-up, 11 Nov): a Resend API key with sending access only (server-only,
# never NEXT_PUBLIC_). Unset: sign-ups are confirmed at once, no email. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=CasePace <noreply@casepace.io>
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
# Drills: force one grading model for every call (tests only; ignored in production).
# DRILL_GRADER_MODEL=claude-haiku-5-5

# Interviewer experiments (optional; defaults: Sonnet 5.5, state-in-system layout)
# INTERVIEWER_PROVIDER=cerebras            # evaluated 7 Oct, not adopted
# INTERVIEWER_PROMPT_LAYOUT=cached-history # evaluated 7 Oct, not adopted
CEREBRAS_API_KEY=
# CEREBRAS_REASONING_EFFORT=low   CEREBRAS_MAX_TOKENS=2048   CEREBRAS_RPM=5
# OpenAI — only for the interviewer latency screening (REPLAY_ARM=model-ab: GPT-6 Luna, GPT-6.1 Sol); not a production provider
OPENAI_API_KEY=
# Gemini — only for the same screening (gemini-3.8-flash, thinking low)
GEMINI_API_KEY=

# App
CLUB_CODES=  # comma-separated valid club codes (server-side only)

# Voice (M0 spike, lib/voice — never NEXT_PUBLIC_)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional: fixed Cartesia voices (default: first English voices in the catalog)
CARTESIA_VOICE_ID=
CARTESIA_CANDIDATE_VOICE_ID=
# LiveKit Cloud project: the wss:// URL from project settings; key/secret are server-only.
# Local development uses its OWN LiveKit project (docs/voice-deploy.md "Local development"), never production's:
# outside production a LIVEKIT_URL on production's project (case-tester-t1foysn4) is refused by the token route
# and by `npm run voice:agent`. VOICE_DEV_ALLOW_PROD_LIVEKIT=1 overrides that, deliberately.
LIVEKIT_URL=wss://your-dev-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# VOICE_DEV_ALLOW_PROD_LIVEKIT=1
# Voice M0 Phase B (spec docs/superpowers/specs/2026-10-08-voice-phase-b-local-interview-design.md)
VOICE_DEV=1                    # show the voice link on the case page
# VOICE_TTS=fake               # free tone TTS for development (set per run, not here)
# VOICE_TTS_RUN_CAP=15000      # characters per agent run — required whenever VOICE_TTS is not fake
VOICE_TTS_CHAR_CAP=90000       # monthly Cartesia characters across runs (Pro = 100K)
VOICE_BARGE_MIN_WORDS=2
VOICE_MAX_SESSION_MIN=25
VOICE_STT_KEYTERMS=                # "1" opens Flux with keyterms (lib/voice/keyterms.ts); off until the A/B
# VOICE_ENV_FILE=../../../.env.local   # npm run voice:agent from a worktree
# Voice deploy (18 Oct; docs/voice-deploy.md)
# VOICE_MAX_CONCURRENT=1        # Vercel: live voice rooms before "Voice is busy" (token route)
# VOICE_ACK_SYNTH=0             # worker: no clip synthesis at start (set in the Dockerfile)
# VOICE_RECORDS_DIR=            # worker: also write voice-live jsonl locally (npm run voice:agent sets it)
# LLM_BUDGET_USD=1.00           # worker: per-session LLM cap (default in code)
# DATA_LINE_VARIANTS=0          # prof-001's pre-written data-line versions (cases/variants): on by default; 0 turns them off
# VOICE_CHECKIN_MS=90000        # worker: the soft silence check-in after this much silence; 0 = off
# VOICE_CHECKIN_OPENER_MS=180000 # worker: the first silence, after the case prompt

# Drills: secret for the scheduled grading-retry endpoint (/api/internal/drills/grading).
# Vercel Cron sends it as a Bearer token. Optional until a schedule is set up.
CRON_SECRET=generate_a_long_random_string
# Interview start limits (lib/session-limits.ts). Defaults: 2 per 24 hours and 8 per calendar month per student,
# 150 per month site-wide. Exempt users (comma-separated Supabase user ids) are never limited or counted.
CASE_SESSIONS_PER_DAY=
CASE_SESSIONS_PER_MONTH=
CASE_SESSIONS_SITE_PER_MONTH=
# Most interviews in progress at once across the site (default 5; a turn in the last 10 minutes counts as in
# progress). A sixth start is told all slots are in use. Exempt users neither take nor need a slot.
CASE_MAX_IN_PROGRESS=
# Rate limits (lib/rate-limit.ts; blank = the default). Sign-ups and club-code attempts are counted per IP, the rest
# per student. Past a limit the route answers 429 with Retry-After.
RATE_LIMIT_SIGN_UPS_PER_HOUR=
RATE_LIMIT_CLUB_CODES_PER_HOUR=
RATE_LIMIT_TURNS_PER_MINUTE=
RATE_LIMIT_VOICE_TOKENS_PER_HOUR=
RATE_LIMIT_REPORT_PDFS_PER_HOUR=
RATE_LIMIT_PASSWORD_RESETS_PER_HOUR=
RATE_LIMIT_VERIFY_EMAILS_PER_HOUR=
CASE_LIMIT_EXEMPT_USER_IDS=
# The Supabase user id that owns sessions created by test scripts (live-run, persona batches, voice-latency,
# voice-demo). Required by those scripts; use your own id and list it in CASE_LIMIT_EXEMPT_USER_IDS too.
SCRIPT_USER_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SECRET_KEY=your_secret_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Interviewer experiments (optional; defaults: Sonnet 5.5, state-in-system layout)
# INTERVIEWER_PROVIDER=cerebras            # evaluated 7 Oct, not adopted
# INTERVIEWER_PROMPT_LAYOUT=cached-history # evaluated 7 Oct, not adopted
CEREBRAS_API_KEY=
# CEREBRAS_REASONING_EFFORT=low   CEREBRAS_MAX_TOKENS=2048   CEREBRAS_RPM=5
# OpenAI — only for the interviewer latency screening (REPLAY_ARM=model-ab: GPT-6 Luna, GPT-6.1 Sol); not a production provider
OPENAI_API_KEY=
# Gemini — only for the same screening (gemini-3.8-flash, thinking low)
GEMINI_API_KEY=

# App
CLUB_CODES=HARVARD2026,WHARTON2026  # comma-separated valid club codes (server-side only)

# Voice (M0 spike, lib/voice — never NEXT_PUBLIC_)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional: fixed Cartesia voices (default: first English voices in the catalog)
CARTESIA_VOICE_ID=
CARTESIA_CANDIDATE_VOICE_ID=
# LiveKit Cloud project: the wss:// URL from project settings; key/secret are server-only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Voice M0 Phase B (spec docs/superpowers/specs/2026-10-08-voice-phase-b-local-interview-design.md)
VOICE_DEV=1                    # show the voice link on the case page
# VOICE_TTS=fake               # free tone TTS for development (set per run, not here)
# VOICE_TTS_RUN_CAP=15000      # characters per agent run — required whenever VOICE_TTS is not fake
VOICE_TTS_CHAR_CAP=90000       # monthly Cartesia characters across runs (Pro = 100K)
VOICE_BARGE_MIN_WORDS=2
VOICE_MAX_SESSION_MIN=25
# VOICE_ENV_FILE=../../../.env.local   # npm run voice:agent from a worktree

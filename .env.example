# Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SECRET_KEY=your_secret_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
# Drills: force one grading model for every call (tests only; ignored in production).
# DRILL_GRADER_MODEL=claude-haiku-5-5

# App
CLUB_CODES=HARVARD2026,WHARTON2026  # comma-separated valid club codes (server-side only)

# Drills: secret for the scheduled grading-retry endpoint (/api/internal/drills/grading).
# Vercel Cron sends it as a Bearer token. Optional until a schedule is set up.
CRON_SECRET=generate_a_long_random_string

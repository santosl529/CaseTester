  "definitions": [
    {
      "term": "monthly gross margin",
      "text": "Monthly gross margin is a plan's monthly price less its monthly cost to serve.",
      "steps": ["pro_margin", "starter_margin"],
      "items": ["plan_prices_costs"]
    },
    {
      "term": "monthly cancellation rate",
      "text": "The monthly cancellation rate is the share of a plan's customers who cancel each month; for Starter it counts customers who cancel, not those who upgrade to Pro.",
      "steps": ["pro_churn", "starter_churn"],
      "items": ["pro_cohort", "starter_cohort"]
    },
    {
      "term": "lifetime value",
      "text": "Lifetime value is monthly gross margin times expected lifetime in months, and expected lifetime is about one divided by the monthly cancellation rate.",
      "steps": ["pro_ltv", "starter_ltv"],
      "items": ["ltv_definition"]
    },
    {
      "term": "LTV to CAC ratio",
      "text": "The LTV to CAC ratio is a customer's lifetime value divided by the cost to acquire that customer, the measure the board's rule sets a floor on.",
      "steps": ["pro_ratio", "starter_ratio", "starter_ratio_with_upgrades"],
      "items": ["board_rule_definition", "plan_cac"]
    },
    {
      "term": "upgrade rate",
      "text": "The upgrade rate is the share of a Starter cohort that has moved to Pro and is still a customer by the end of its first year.",
      "steps": ["upgrade_rate"],
      "items": ["starter_cohort"]
    },
    {
      "term": "Starter value with upgrades",
      "text": "A Starter sign-up's value is its Starter lifetime value plus the upgrade rate times one Pro lifetime value.",
      "steps": ["starter_value_with_upgrades", "starter_value_at_60"],
      "items": ["cohort_notes"]
    },
    {
      "term": "net value per sign-up",
      "text": "Net value per sign-up is a customer's lifetime value, upgrades included for Starter, less its acquisition cost.",
      "steps": ["starter_net_value", "pro_net_value", "starter_value_at_60"]
    },
    {
      "term": "lost Pro sign-ups",
      "text": "Lost Pro sign-ups are the monthly Pro sign-ups before Starter launched less the monthly Pro sign-ups since.",
      "steps": ["lost_pro_signups"],
      "items": ["new_customers_by_plan"]
    },
    {
      "term": "value of a month of sign-ups",
      "text": "The value of a month of sign-ups is each plan's monthly sign-ups times its net value per sign-up, added across the plans.",
      "steps": ["value_pro_only", "value_with_starter", "value_at_60"],
      "items": ["new_customers_by_plan", "price_test_results"]
    },
    {
      "term": "value Starter adds",
      "text": "The value Starter adds is the value of a month of sign-ups with Starter less the value of a month of Pro-only sign-ups before it launched.",
      "steps": ["starter_value_added"]
    },
    {
      "term": "cannibalization breakeven",
      "text": "The cannibalization breakeven is the Starter sign-ups' net value in a month divided by the net value of one Pro sign-up: how many Pro sign-ups Starter could take before it stopped adding value.",
      "steps": ["cannibalization_breakeven"]
    },
    {
      "term": "price test uplift",
      "text": "The uplift at the test price is the value of a month of sign-ups at the test price less the value at today's Starter price.",
      "steps": ["uplift_at_60"],
      "items": ["price_test_results"]
    },
    {
      "term": "test-price breakevens",
      "text": "The breakeven cancellation rate and upgrade rate at the test price are the levels at which a test-price Starter sign-up stops being worth more than one at today's price, the other rate held as today.",
      "steps": ["churn_breakeven_at_60", "upgrade_breakeven_at_60"],
      "items": ["price_test_notes"]
    }
  ]
}
